# 本文件只提供变量名和安全默认值，禁止填写后提交真实密钥。
# Release bootstrap resolves these against project root (no machine paths).
DATA_ROOT=data
PORT=8000
HOST=127.0.0.1
# Docker defaults to local-only. Explicit server publication (after access review):
PMC_BIND_IP=127.0.0.1
PMC_HTTP_PORT=8080
# Optional: relocation of the committed public package/runtime separately.
# PMC_PUBLIC_DATA_ROOT=/app/data/public
# PMC_RUNTIME_ROOT=/var/lib/pmc-agent
# Browser production build: VITE_API_BASE_URL=/ (same-origin nginx /api).
PMC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional model settings used by the development entry only. The public entry
# uses deterministic business replies; public data authorization does NOT grant
# permission to send Evidence to third-party models. No key required to deploy.
LLM_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=6
LLM_MAX_RETRIES=1
