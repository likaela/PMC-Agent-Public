{
  "name": "pmc-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html",
    "test:unit": "node --test tests/store.test.mjs tests/live.test.mjs tests/conversation.test.mjs tests/thoughtline.test.mjs"
  },
  "dependencies": {
    "@vueuse/core": "14.4.0",
    "motion-v": "2.6.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.8"
  }
}
